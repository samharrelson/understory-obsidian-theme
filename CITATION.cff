cff-version: 1.2.0
message: "If you use Understory, please cite it using the metadata from this file."

title: "Understory"
type: software
version: "0.2.3"
date-released: "2026-11-05"

authors:
  - family-names: "Harrelson"
    given-names: "Sam"
    orcid: "https://orcid.org/0009-0003-8261-9316"

abstract: >-
  Understory is a warm, quiet Obsidian theme designed for long-form reading,
  research, field notes, and writing. It uses parchment and walnut-shell
  light and dark modes, bookish serif typography, restrained moss and autumn
  accents, quieter navigation and graph styling, native research callouts,
  opt-in seasonal palettes, and field-journal note styling.

repository-code: "https://github.com/samharrelson/understory-obsidian-theme"
url: "https://github.com/samharrelson/understory-obsidian-theme"

# The version-specific DOI for 0.2.3 will be assigned after Zenodo archives the GitHub release.
